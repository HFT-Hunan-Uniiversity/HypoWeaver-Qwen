{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/group1_handoff.schema.json",
  "title": "Group 1 to Group 2 scientific hypothesis handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "generated_at", "status", "group1_scope",
    "completed_gates", "final_hypothesis", "source_artifacts", "scientific_constraints",
    "group2_scope", "unresolved_conditions"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ready_for_group2" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completed_gates": {
            "items": {
              "properties": { "status": { "const": "passed" } }
            }
          },
          "unresolved_conditions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "ready_for_group2_with_conditions" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completed_gates": {
            "items": {
              "properties": { "status": { "enum": ["passed", "conditional"] } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "blocked" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completed_gates": {
            "contains": {
              "properties": { "status": { "const": "failed" } },
              "required": ["status"]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "handoff_id": { "type": "string", "pattern": "^group1-handoff:[a-f0-9]{24}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready_for_group2", "ready_for_group2_with_conditions", "blocked"] },
    "group1_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "included", "excluded"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "included": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "completed_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "evidence"],
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "conditional", "failed"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "final_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "gap_id", "title", "statement", "falsifiable_form", "status", "novelty_judgement"],
      "properties": {
        "hypothesis_id": { "type": "string", "minLength": 1 },
        "gap_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "falsifiable_form": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "novelty_judgement": { "type": "string", "minLength": 1 }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "scientific_constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "group2_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "starting_tasks", "must_not_change_without_return_to_group1"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "starting_tasks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "must_not_change_without_return_to_group1": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "unresolved_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
