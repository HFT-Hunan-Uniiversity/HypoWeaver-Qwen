{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/retrieval_result.schema.json",
  "title": "GreenFin retrieval result envelope",
  "description": "Traceable vector retrieval output. Text is optional and may only be emitted under the caller's access policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "index_snapshot_id",
    "query_hash",
    "filter",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "greenfin-retrieval-result/1.0.0"
    },
    "index_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "query_hash": {
      "$ref": "#/$defs/sha256"
    },
    "filter": {
      "$ref": "#/$defs/filter"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_string": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "$ref": "#/$defs/filter_values"
        },
        "source_type": {
          "$ref": "#/$defs/filter_values"
        },
        "access_level": {
          "$ref": "#/$defs/filter_values"
        }
      }
    },
    "filter_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "document_id",
        "evidence_id",
        "score",
        "rank",
        "locator"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "object"
        },
        "release_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "asset_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "document_version": {
          "$ref": "#/$defs/nullable_string"
        },
        "content_hash": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "content_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "text_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "access_level": {
          "$ref": "#/$defs/nullable_string"
        },
        "license": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_type": {
          "$ref": "#/$defs/nullable_string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "text_redacted": {
          "type": "boolean"
        }
      }
    }
  }
}
