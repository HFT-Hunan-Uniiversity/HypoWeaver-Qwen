{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/graph_query.schema.json",
  "title": "Graph-RAG query API contract",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "message_type", "query_id", "graph_snapshot_id", "intent", "seeds", "filters", "traversal", "evidence_policy"],
      "properties": {
        "contract_version": { "const": "0.2.0" },
        "message_type": { "const": "request" },
        "query_id": { "type": "string", "minLength": 1 },
        "graph_snapshot_id": { "type": "string", "minLength": 1 },
        "intent": {
          "enum": ["summarize_landscape", "compare_streams", "track_frontier", "trace_mechanism", "compare_findings", "find_gaps", "assess_data_feasibility", "find_did_opportunities", "expand_evidence", "custom"]
        },
        "question": { "type": ["string", "null"] },
        "seeds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_ids", "labels"],
          "properties": {
            "node_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "labels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "year_from": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
            "year_to": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
            "layers": { "type": "array", "uniqueItems": true, "items": { "enum": ["source", "knowledge", "analytics", "discovery"] } },
            "origins": { "type": "array", "uniqueItems": true, "items": { "enum": ["extracted", "curated", "computed", "inferred"] } },
            "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "verification_statuses": { "type": "array", "uniqueItems": true, "items": { "enum": ["unverified", "source_located", "cross_checked", "not_applicable"] } }
          }
        },
        "traversal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_hops", "direction", "max_nodes"],
          "properties": {
            "max_hops": { "type": "integer", "minimum": 1, "maximum": 4 },
            "direction": { "enum": ["outgoing", "incoming", "both"] },
            "allowed_edge_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "max_nodes": { "type": "integer", "minimum": 1, "maximum": 500 }
          }
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "graph_weight": { "type": "number", "minimum": 0 },
            "evidence_weight": { "type": "number", "minimum": 0 },
            "recency_weight": { "type": "number", "minimum": 0 },
            "diversity_weight": { "type": "number", "minimum": 0 }
          }
        },
        "evidence_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_scientific_evidence", "include_quotes", "max_evidence_per_edge"],
          "properties": {
            "require_scientific_evidence": { "type": "boolean" },
            "include_quotes": { "type": "boolean" },
            "max_evidence_per_edge": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "message_type", "query_id", "graph_snapshot_id", "status", "matched_seed_nodes", "subgraph", "paths", "aggregates", "warnings"],
      "properties": {
        "contract_version": { "const": "0.2.0" },
        "message_type": { "const": "response" },
        "query_id": { "type": "string", "minLength": 1 },
        "graph_snapshot_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["success", "partial", "no_evidence", "error"] },
        "matched_seed_nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "subgraph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges", "evidence"],
          "properties": {
            "nodes": { "type": "array", "items": { "$ref": "research_graph.schema.json#/$defs/node" } },
            "edges": { "type": "array", "items": { "$ref": "research_graph.schema.json#/$defs/edge" } },
            "evidence": { "type": "array", "items": { "$ref": "research_graph.schema.json#/$defs/evidence" } }
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_ids", "edge_ids", "score", "rationale"],
            "properties": {
              "node_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "edge_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "score": { "type": "number" },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        },
        "aggregates": { "type": "object", "additionalProperties": true },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
