{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/discovery_config.schema.json",
  "title": "Configuration for deterministic discovery output construction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "landscape", "gaps", "hypotheses"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "inferred_entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/inferredEntity" }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "build_timestamp",
        "pipeline_run_id",
        "corpus_limit_statement",
        "small_sample_threshold"
      ],
      "properties": {
        "as_of": { "type": "string", "format": "date-time" },
        "build_timestamp": { "type": "string", "format": "date-time" },
        "pipeline_run_id": { "type": "string", "minLength": 1 },
        "corpus_limit_statement": { "type": "string", "minLength": 1 },
        "small_sample_threshold": { "type": "integer", "minimum": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "code_version": { "type": ["string", "null"] }
      }
    },
    "landscape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "methodology",
        "cluster_stability",
        "warnings",
        "fields",
        "streams",
        "controversies",
        "frontier_signals"
      ],
      "properties": {
        "window": { "$ref": "#/$defs/window" },
        "methodology": { "$ref": "#/$defs/methodology" },
        "cluster_stability": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "streams": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stream" } },
        "controversies": { "type": "array", "items": { "$ref": "#/$defs/controversy" } },
        "frontier_signals": { "type": "array", "items": { "$ref": "#/$defs/frontier" } }
      }
    },
    "gaps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gap" } },
    "hypotheses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hypothesis" } }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._:-]*$"
    },
    "nodeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nodeId" }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nodeId" }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_from", "current_to", "baseline_from", "baseline_to"],
      "properties": {
        "current_from": { "type": "string", "format": "date" },
        "current_to": { "type": "string", "format": "date" },
        "baseline_from": { "type": "string", "format": "date" },
        "baseline_to": { "type": "string", "format": "date" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibility_rule", "clustering", "trend_scoring", "llm_labeling"],
      "properties": {
        "eligibility_rule": { "type": "string", "minLength": 1 },
        "clustering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["features", "algorithm", "version", "parameters"],
          "properties": {
            "features": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["citation", "bibliographic_coupling", "text_embedding", "graph_entities", "co_author", "policy_link"] }
            },
            "algorithm": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object", "additionalProperties": true }
          }
        },
        "trend_scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formula_version", "component_weights"],
          "properties": {
            "formula_version": { "type": "string", "minLength": 1 },
            "component_weights": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          }
        },
        "llm_labeling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "prompt_hash", "temperature"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "prompt_hash": { "type": "string", "minLength": 8 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    },
    "metricInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citation_velocity": { "type": ["number", "null"] }
      }
    },
    "inferredEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "label", "description", "confidence", "evidence_ids",
        "derivation", "properties"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": {
          "enum": [
            "variable", "measure", "dataset", "method", "model",
            "identification_strategy", "mechanism"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "method_version", "input_refs", "input_edge_refs", "parameters", "prompt_hash"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "method_version": { "type": "string", "minLength": 1 },
            "input_refs": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
            "input_edge_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nodeId" }
            },
            "parameters": { "type": "object", "additionalProperties": true },
            "prompt_hash": { "type": ["string", "null"], "minLength": 8 }
          }
        },
        "properties": {
          "type": "object",
          "required": ["definition", "granularity"],
          "properties": {
            "definition": { "type": "string", "minLength": 1 },
            "granularity": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "graph_node_id", "label", "member_paper_ids", "top_topic_ids", "top_model_ids", "evidence_ids"],
      "properties": {
        "field_id": { "type": "string", "minLength": 1 },
        "graph_node_id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string", "minLength": 1 },
        "member_paper_ids": { "$ref": "#/$defs/nodeIds" },
        "top_topic_ids": { "$ref": "#/$defs/nodeIds" },
        "top_model_ids": { "$ref": "#/$defs/nodeIds" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "metric_inputs": { "$ref": "#/$defs/metricInputs" }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id", "trend_id", "label", "description", "label_confidence",
        "field_ids", "member_paper_ids", "core_paper_ids", "top_topic_ids",
        "top_theory_ids", "top_mechanism_ids", "top_variable_ids",
        "top_method_ids", "top_model_ids", "evidence_ids"
      ],
      "properties": {
        "stream_id": { "$ref": "#/$defs/nodeId" },
        "trend_id": { "$ref": "#/$defs/nodeId" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "label_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "field_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "member_paper_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
        "core_paper_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
        "top_topic_ids": { "$ref": "#/$defs/nodeIds" },
        "top_theory_ids": { "$ref": "#/$defs/nodeIds" },
        "top_mechanism_ids": { "$ref": "#/$defs/nodeIds" },
        "top_variable_ids": { "$ref": "#/$defs/nodeIds" },
        "top_method_ids": { "$ref": "#/$defs/nodeIds" },
        "top_model_ids": { "$ref": "#/$defs/nodeIds" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "metric_inputs": { "$ref": "#/$defs/metricInputs" }
      }
    },
    "controversy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controversy_id", "statement", "finding_ids", "direction_distribution", "evidence_ids"],
      "properties": {
        "controversy_id": { "$ref": "#/$defs/nodeId" },
        "statement": { "type": "string", "minLength": 1 },
        "finding_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 2 }] },
        "direction_distribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "evidence_ids": { "allOf": [{ "$ref": "#/$defs/evidenceIds" }, { "minItems": 2 }] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "signal_type", "statement", "score", "graph_node_ids", "evidence_ids"],
      "properties": {
        "signal_id": { "type": "string", "minLength": 1 },
        "signal_type": { "enum": ["rapid_growth", "new_policy", "new_dataset", "new_model", "cross_stream_bridge", "citation_burst"] },
        "statement": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "graph_node_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "gap_id", "gap_type", "title", "statement", "current_state", "missing_piece",
        "why_important", "signals", "supporting_graph_refs", "supporting_evidence_ids",
        "counterevidence_ids", "novelty_search_id", "data_feasibility", "scores",
        "status", "derivation", "review", "graph_links"
      ],
      "properties": {
        "gap_id": { "$ref": "#/$defs/nodeId" },
        "gap_type": { "enum": ["mechanism", "data", "population", "context", "method", "model", "policy", "controversy", "temporal", "cross_stream"] },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "current_state": { "type": "string", "minLength": 1 },
        "missing_piece": { "type": "string", "minLength": 1 },
        "why_important": { "type": "string", "minLength": 1 },
        "signals": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "supporting_graph_refs": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
        "supporting_evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "counterevidence_ids": { "$ref": "#/$defs/nodeIds" },
        "novelty_search_id": { "type": "string", "minLength": 1 },
        "novelty_assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage_status": { "enum": ["open", "partially_covered", "covered", "uncertain"] },
            "remaining_difference": { "type": "string", "minLength": 1 },
            "max_nearest_works": { "type": "integer", "minimum": 1, "maximum": 100 },
            "nearest_works": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["paper_id", "title", "year", "overlap", "difference", "verification_status"],
                "properties": {
                  "paper_id": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
                  "overlap": { "type": "string", "minLength": 1 },
                  "difference": { "type": "string", "minLength": 1 },
                  "verification_status": { "enum": ["verified", "unverified", "rejected"] }
                }
              }
            }
          }
        },
        "data_feasibility": { "type": "object" },
        "candidate_research_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "scores": { "type": "object" },
        "status": { "enum": ["candidate", "needs_human_review", "accepted", "rejected"] },
        "derivation": { "type": "object" },
        "review": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "graph_links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indicator_node_ids", "support_node_ids", "challenge_node_ids", "concern_node_ids", "enabled_by_node_ids"],
          "properties": {
            "indicator_node_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
            "support_node_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
            "challenge_node_ids": { "$ref": "#/$defs/nodeIds" },
            "concern_node_ids": { "$ref": "#/$defs/nodeIds" },
            "enabled_by_node_ids": { "$ref": "#/$defs/nodeIds" }
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "hypothesis_id", "gap_card_ids", "title", "hypothesis_statement", "falsifiable_form",
        "rationale", "mechanism_chain", "variables", "boundary_conditions", "predictions",
        "evidence_balance", "novelty_check_ref", "feasibility", "recommended_design",
        "scores", "handoff", "status", "review", "graph_links"
      ],
      "properties": {
        "hypothesis_id": { "$ref": "#/$defs/nodeId" },
        "gap_card_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
        "title": { "type": "string", "minLength": 1 },
        "hypothesis_statement": { "type": "string", "minLength": 1 },
        "falsifiable_form": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "mechanism_chain": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "variables": { "type": "object" },
        "boundary_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "predictions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "evidence_balance": { "type": "object" },
        "novelty_check_ref": { "type": "string", "minLength": 1 },
        "feasibility": { "type": "object" },
        "recommended_design": { "type": "object" },
        "scores": { "type": "object" },
        "handoff": { "type": "object" },
        "status": { "enum": ["draft", "needs_scientific_review", "needs_feasibility_review", "approved_for_output", "rejected"] },
        "review": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "graph_links": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predictor_node_ids", "outcome_node_ids", "mediator_node_ids", "moderator_node_ids",
            "mechanism_node_ids", "support_node_ids", "challenge_node_ids", "enabled_by_node_ids",
            "recommended_method_ids", "recommended_model_ids", "recommended_identification_strategy_ids",
            "recommended_dataset_ids"
          ],
          "properties": {
            "predictor_node_ids": { "$ref": "#/$defs/nodeIds" },
            "outcome_node_ids": { "allOf": [{ "$ref": "#/$defs/nodeIds" }, { "minItems": 1 }] },
            "mediator_node_ids": { "$ref": "#/$defs/nodeIds" },
            "moderator_node_ids": { "$ref": "#/$defs/nodeIds" },
            "mechanism_node_ids": { "$ref": "#/$defs/nodeIds" },
            "support_node_ids": { "$ref": "#/$defs/nodeIds" },
            "challenge_node_ids": { "$ref": "#/$defs/nodeIds" },
            "enabled_by_node_ids": { "$ref": "#/$defs/nodeIds" },
            "recommended_method_ids": { "$ref": "#/$defs/nodeIds" },
            "recommended_model_ids": { "$ref": "#/$defs/nodeIds" },
            "recommended_identification_strategy_ids": { "$ref": "#/$defs/nodeIds" },
            "recommended_dataset_ids": { "$ref": "#/$defs/nodeIds" }
          }
        }
      }
    }
  }
}
