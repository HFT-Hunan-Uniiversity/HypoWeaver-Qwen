{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/policy_profile.graph_input.schema.json",
  "title": "PolicyProfile graph input contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "document", "instruments", "provisions", "targets", "document_relations", "research_design_signals", "research_implications", "evidence", "quality"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "document": { "$ref": "#/$defs/document" },
    "instruments": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "provisions": { "type": "array", "items": { "$ref": "#/$defs/provision" } },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "document_relations": { "type": "array", "items": { "$ref": "#/$defs/documentRelation" } },
    "research_design_signals": { "$ref": "#/$defs/designSignals" },
    "research_implications": { "type": "array", "items": { "$ref": "#/$defs/evidencedText" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "quality": { "$ref": "#/$defs/quality" }
  },
  "$defs": {
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "issuer", "published_date", "status", "jurisdiction", "language", "document_version", "source_uri", "metadata_evidence_refs"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "document_number": { "type": ["string", "null"] },
        "published_date": { "type": "string", "format": "date" },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "expiry_date": { "type": ["string", "null"], "format": "date" },
        "status": { "enum": ["draft", "active", "amended", "superseded", "expired", "unknown"] },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "document_version": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "checksum": { "type": ["string", "null"] },
        "metadata_evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "name", "category", "description", "evidence_refs"],
      "properties": {
        "local_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["disclosure", "credit", "bond", "subsidy", "tax", "supervision", "penalty", "taxonomy", "pilot", "standard", "other"] },
        "description": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provision_id", "provision_type", "text", "instrument_refs", "target_refs", "mandatory", "evidence_refs"],
      "properties": {
        "provision_id": { "type": "string", "minLength": 1 },
        "provision_type": { "enum": ["obligation", "prohibition", "incentive", "penalty", "definition", "eligibility", "reporting", "other"] },
        "text": { "type": "string", "minLength": 1 },
        "instrument_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "target_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mandatory": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "target_type", "name", "evidence_refs"],
      "properties": {
        "local_id": { "type": "string", "minLength": 1 },
        "target_type": { "enum": ["industry", "firm", "financial_institution", "investor", "region", "technology", "activity", "disclosure_item", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "documentRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "target_document_id", "target_title", "evidence_refs"],
      "properties": {
        "relation": { "enum": ["amends", "supersedes", "implements", "cites", "interprets"] },
        "target_document_id": { "type": ["string", "null"] },
        "target_title": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "designSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollout_type", "effective_date", "treated_units", "potential_control_units", "threshold_rule", "staggered_timing", "candidate_designs", "plausibility_notes", "evidence_refs"],
      "properties": {
        "rollout_type": { "enum": ["national", "regional_pilot", "industry_specific", "threshold_based", "staggered", "voluntary", "unknown"] },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "treated_units": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "potential_control_units": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "threshold_rule": { "type": ["string", "null"] },
        "staggered_timing": { "type": "boolean" },
        "candidate_designs": { "type": "array", "items": { "enum": ["did", "event_study", "rdd", "synthetic_control", "interrupted_time_series", "descriptive", "unknown"] } },
        "plausibility_notes": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "evidencedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "document_id", "document_version", "quote", "chunk_id", "section", "page", "verification_status"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "document_version": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "chunk_id": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "page": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "minLength": 1 }, { "type": "null" }] },
        "verification_status": { "enum": ["unverified", "source_located", "cross_checked", "rejected"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_confidence", "document_identity_status", "human_review_status", "extractor", "extractor_version"],
      "properties": {
        "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "document_identity_status": { "enum": ["verified", "unverified", "rejected"] },
        "human_review_status": { "enum": ["not_reviewed", "sampled", "fully_reviewed"] },
        "extractor": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
