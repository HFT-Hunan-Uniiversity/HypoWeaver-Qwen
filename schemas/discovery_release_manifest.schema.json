{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/discovery_release_manifest.schema.json",
  "title": "Deterministic discovery release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "created_at", "generator", "corpus_limit_statement",
    "inputs", "artifacts", "verification"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "release_id": { "type": "string", "pattern": "^discovery_release:[a-f0-9]{24}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "minLength": 1 },
    "corpus_limit_statement": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_graph_snapshot_id", "base_graph_sha256", "config_sha256", "novelty_search_sha256"],
      "properties": {
        "base_graph_snapshot_id": { "type": "string", "minLength": 1 },
        "base_graph_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "novelty_search_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_graph", "research_landscape", "gap_cards", "hypothesis_cards"],
      "properties": {
        "final_graph": { "$ref": "#/$defs/artifact" },
        "research_landscape": { "$ref": "#/$defs/artifact" },
        "gap_cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cardArtifact" } },
        "hypothesis_cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cardArtifact" } }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_validated", "semantic_graph_validated", "cross_references_validated", "errors", "warnings"],
      "properties": {
        "schema_validated": { "const": true },
        "semantic_graph_validated": { "const": true },
        "cross_references_validated": { "const": true },
        "errors": { "type": "array", "maxItems": 0 },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "snapshot_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_version": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 }
      }
    },
    "cardArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schema_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
