# RAG-Graph 环境变量模板
# 复制为 .env 并填写真实值，.env 不进 Git（已在 .gitignore 中）

# === 必填 ===
# DashScope API Key（KG 抽取 + 问答都用这个，qwen-max / qwen-turbo）
DASHSCOPE_API_KEY=

# === 可选（默认值已合理） ===
# 向量存储后端: hdf5（当前实现） / qdrant（预留，未实现）
VECTOR_BACKEND=hdf5

# === 远程问答（可选，本地跑不需要） ===
# 服务器 IP 和 SSH 用户（免密登录已配置时可填）
# SERVER_IP=106.53.153.215
# SERVER_USER=greenfinance-vector

# === MinerU 云 API（解析 PDF 时必填） ===
# MINERU_API_KEY=

# === Neo4j（预留，未使用） ===
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=