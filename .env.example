# Copy this file to .env before using Docker Compose.
# Every value below is a placeholder. Never commit the resulting .env file.

# Protect every mutation endpoint exposed outside loopback.
HYPOWEAVER_API_TOKEN=change-me-workflow-token
HYPOWEAVER_ACTOR=container_researcher

# HMAC seal key. Must contain at least 32 bytes and must remain stable across restarts.
HYPOWEAVER_SEAL_SECRET=change-me-at-least-32-bytes-long-0001

# Workflow -> Research Engine service authentication.
RESEARCH_ENGINE_URL=http://research-engine:8001
RESEARCH_ENGINE_TOKEN=change-me-research-engine-token

# Workflow -> Knowledge service authentication.
KNOWLEDGE_SERVICE_URL=http://knowledge:8002
KNOWLEDGE_SERVICE_TOKEN=change-me-knowledge-service-token

# Read-only knowledge artifacts. The host directory is mounted at /app/knowledge.
HYPOWEAVER_KNOWLEDGE_DATA_DIR=./knowledge-data
HYPOWEAVER_KNOWLEDGE_CATALOG_PATH=/app/knowledge/evidence.jsonl
HYPOWEAVER_KNOWLEDGE_CHUNK_CATALOG_PATH=/app/knowledge/chunks.jsonl
HYPOWEAVER_KNOWLEDGE_CLEANED_DIR=/app/knowledge/cleaned
HYPOWEAVER_KNOWLEDGE_METADATA_DIR=/app/knowledge/cleaned_meta
HYPOWEAVER_KNOWLEDGE_DOCUMENT_REGISTRY_PATH=/app/knowledge/manifests/doc_registry.csv
HYPOWEAVER_KNOWLEDGE_VECTOR_PATH=/app/knowledge/all_store.h5
HYPOWEAVER_KNOWLEDGE_GRAPH_DIR=/app/knowledge/kg
HYPOWEAVER_KNOWLEDGE_MANIFEST_PATH=/app/knowledge/manifest.json
HYPOWEAVER_KNOWLEDGE_CORPUS_SNAPSHOT_ID=
# auto selects BGE sentence-transformers when the Aug-23 HDF5 artifact exists.
# Use hashing only for dependency-free JSONL test catalogs built with hashing.
HYPOWEAVER_KNOWLEDGE_EMBEDDING_BACKEND=hashing
HYPOWEAVER_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HYPOWEAVER_KNOWLEDGE_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620

# Optional Qwen / DashScope configuration. Leave the key empty for code_owned or fixture runs.
# New sk-ws keys must use the API Host shown alongside that exact key in Model Studio;
# do not reuse the legacy public URL below when the console provides a workspace-specific Host.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Frontend development proxy only. Docker serves frontend and API from one origin.
VITE_API_TARGET=http://127.0.0.1:8000
VITE_PUBLIC_DEMO=false
HYPOWEAVER_PORT=8000

# Optional override for immutable original PDFs and extracted page text layers.
HYPOWEAVER_LITERATURE_ROOT=/app/backend/var/literature
