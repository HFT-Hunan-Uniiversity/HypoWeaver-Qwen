# Copy this file to .env before using Docker Compose.
# Every value below is a placeholder. Never commit the resulting .env file.

# Protect every mutation endpoint exposed outside loopback.
HYPOWEAVER_API_TOKEN=change-me-workflow-token
HYPOWEAVER_ACTOR=container_researcher

# HMAC seal key. Must contain at least 32 bytes and must remain stable across restarts.
HYPOWEAVER_SEAL_SECRET=change-me-at-least-32-bytes-long-0001

# Workflow -> Research Engine service authentication.
RESEARCH_ENGINE_URL=http://research-engine:8001
RESEARCH_ENGINE_TOKEN=change-me-research-engine-token

# Optional Qwen / DashScope configuration. Leave the key empty for code_owned or fixture runs.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Frontend development proxy only. Docker serves frontend and API from one origin.
VITE_API_TARGET=http://127.0.0.1:8000
VITE_PUBLIC_DEMO=false
HYPOWEAVER_PORT=8000
