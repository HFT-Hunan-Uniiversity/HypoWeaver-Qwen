# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不要把真实密钥提交到 Git。
# 也可以不改本文件，启动后在界面“服务与设置”页填写（保存到 DATA_DIR/.env.llm，优先于本文件）。

# 阿里云百炼（DashScope）API Key；留空时需要大模型的步骤会提示未配置
LLM_API_KEY=
# DashScope 的 OpenAI 兼容模式地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名不写死，可改为 qwen3.8-flash 等（演示机在设置页用的是 qwen3.8-flash）
LLM_MODEL=qwen-plus
# 可选：随 OpenAlex/Crossref 请求发送的联系邮箱
CONTACT_EMAIL=
# 数据目录（SQLite、上传文件、模型配置），相对路径以仓库根目录为准
DATA_DIR=./var
# 可选：本地文献库目录（library.jsonl 或 PDF）
LOCAL_LIBRARY_DIR=
