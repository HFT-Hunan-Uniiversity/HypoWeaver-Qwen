{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/novelty_search.schema.json",
  "title": "Auditable novelty search input",
  "oneOf": [
    { "$ref": "#/$defs/protocol101" },
    { "$ref": "#/$defs/legacyBundle" }
  ],
  "$defs": {
    "protocol101": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "search_id", "searched_at", "as_of", "candidate_gap",
        "query_protocol", "local_snapshot", "searches", "warnings"
      ],
      "properties": {
        "schema_version": { "const": "novelty-search/1.0.1" },
        "search_id": { "type": "string", "pattern": "^novelty:[a-z0-9._:-]+$" },
        "searched_at": { "type": "string", "format": "date-time" },
        "as_of": { "type": "string", "format": "date-time" },
        "candidate_gap": { "type": "string", "minLength": 1 },
        "query_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_semantics", "remote_semantics", "top_result_limit"],
          "properties": {
            "local_semantics": { "type": "string", "minLength": 1 },
            "remote_semantics": { "type": "string", "minLength": 1 },
            "top_result_limit": { "type": "integer", "minimum": 1 }
          }
        },
        "local_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path", "input_record_count", "eligible_as_of_count",
            "future_dated_excluded_count", "input_sha256"
          ],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "input_record_count": { "type": "integer", "minimum": 0 },
            "eligible_as_of_count": { "type": "integer", "minimum": 0 },
            "future_dated_excluded_count": { "type": "integer", "minimum": 0 },
            "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "searches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/querySearch" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "querySearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id", "query_type", "query_text", "concept_groups", "sources"
      ],
      "properties": {
        "query_id": { "type": "string", "minLength": 1 },
        "query_type": { "enum": ["exact", "broad", "mechanism", "adjacent", "other"] },
        "query_text": { "type": "string", "minLength": 1 },
        "concept_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sourceSearch" }
        }
      }
    },
    "sourceSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hit_count", "hit_count_semantics", "evaluated_result_count", "top_results"
      ],
      "properties": {
        "request_url": { "type": "string", "minLength": 1 },
        "hit_count": { "type": "integer", "minimum": 0 },
        "hit_count_semantics": { "type": "string", "minLength": 1 },
        "evaluated_result_count": { "type": "integer", "minimum": 0 },
        "top_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/topResult" }
        }
      }
    },
    "topResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "title", "year", "source"],
      "properties": {
        "paper_id": { "type": ["string", "null"], "minLength": 1 },
        "doi": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"], "minLength": 1 },
        "year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
        "source": { "type": "string", "minLength": 1 },
        "cited_by_count": { "type": ["integer", "null"], "minimum": 0 },
        "matched_group_count": { "type": "integer", "minimum": 0 }
      }
    },
    "legacyBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "searches"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "searches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/legacySearch" }
        }
      }
    },
    "legacySearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "novelty_search_id", "searched_at", "queries", "sources",
        "nearest_works", "coverage_status", "remaining_difference"
      ],
      "properties": {
        "novelty_search_id": { "type": "string", "minLength": 1 },
        "searched_at": { "type": "string", "format": "date-time" },
        "queries": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "query_audit": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "mode", "source", "hit_count", "retrieved_at"],
            "properties": {
              "query": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["exact", "broad", "adjacent", "other"] },
              "source": { "type": "string", "minLength": 1 },
              "hit_count": { "type": ["integer", "null"], "minimum": 0 },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "nearest_works": {
          "type": "array",
          "items": { "$ref": "#/$defs/nearestWork" }
        },
        "coverage_status": { "enum": ["open", "partially_covered", "covered", "uncertain"] },
        "remaining_difference": { "type": "string", "minLength": 1 }
      }
    },
    "nearestWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id", "title", "year", "overlap", "difference", "verification_status"
      ],
      "properties": {
        "paper_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "overlap": { "type": "string", "minLength": 1 },
        "difference": { "type": "string", "minLength": 1 },
        "verification_status": { "enum": ["verified", "unverified", "rejected"] }
      }
    }
  }
}
