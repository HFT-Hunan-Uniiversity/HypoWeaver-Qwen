{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenfin.local/schemas/research_landscape.schema.json",
  "title": "Research landscape snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "graph_snapshot_id", "as_of", "window", "methodology", "fields", "streams", "controversies", "frontier_signals", "quality"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "graph_snapshot_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_from", "current_to", "baseline_from", "baseline_to"],
      "properties": {
        "current_from": { "type": "string", "format": "date" },
        "current_to": { "type": "string", "format": "date" },
        "baseline_from": { "type": "string", "format": "date" },
        "baseline_to": { "type": "string", "format": "date" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibility_rule", "clustering", "trend_scoring", "llm_labeling"],
      "properties": {
        "eligibility_rule": { "type": "string", "minLength": 1 },
        "clustering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["features", "algorithm", "version", "parameters"],
          "properties": {
            "features": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["citation", "bibliographic_coupling", "text_embedding", "graph_entities", "co_author", "policy_link"] } },
            "algorithm": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object", "additionalProperties": true }
          }
        },
        "trend_scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formula_version", "component_weights"],
          "properties": {
            "formula_version": { "type": "string", "minLength": 1 },
            "component_weights": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        },
        "llm_labeling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "prompt_hash", "temperature"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "prompt_hash": { "type": "string", "minLength": 8 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "streams": { "type": "array", "items": { "$ref": "#/$defs/stream" } },
    "controversies": { "type": "array", "items": { "$ref": "#/$defs/controversy" } },
    "frontier_signals": { "type": "array", "items": { "$ref": "#/$defs/frontierSignal" } },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_paper_count", "unassigned_paper_count", "cluster_stability", "warnings"],
      "properties": {
        "eligible_paper_count": { "type": "integer", "minimum": 0 },
        "unassigned_paper_count": { "type": "integer", "minimum": 0 },
        "cluster_stability": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_count", "recent_paper_share", "growth_rate", "citation_velocity", "policy_alignment", "method_diversity", "hotness_score"],
      "properties": {
        "paper_count": { "type": "integer", "minimum": 0 },
        "recent_paper_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "growth_rate": { "type": ["number", "null"] },
        "citation_velocity": { "type": ["number", "null"] },
        "policy_alignment": { "type": "number", "minimum": 0, "maximum": 1 },
        "method_diversity": { "type": "number", "minimum": 0, "maximum": 1 },
        "hotness_score": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "graph_node_id", "label", "metrics", "top_topic_ids", "top_model_ids", "evidence_ids"],
      "properties": {
        "field_id": { "type": "string", "minLength": 1 },
        "graph_node_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "top_topic_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "top_model_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "graph_node_id", "label", "description", "label_confidence", "field_ids", "member_paper_ids", "core_paper_ids", "top_topic_ids", "top_theory_ids", "top_mechanism_ids", "top_variable_ids", "top_method_ids", "top_model_ids", "metrics", "evidence_ids"],
      "properties": {
        "stream_id": { "type": "string", "minLength": 1 },
        "graph_node_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "label_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "field_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "member_paper_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "core_paper_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "top_topic_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "top_theory_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "top_mechanism_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "top_variable_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "top_method_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "top_model_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "metrics": { "$ref": "#/$defs/metrics" },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "controversy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controversy_id", "statement", "finding_ids", "direction_distribution", "evidence_ids"],
      "properties": {
        "controversy_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "finding_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "direction_distribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "evidence_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "frontierSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "signal_type", "statement", "score", "graph_node_ids", "evidence_ids"],
      "properties": {
        "signal_id": { "type": "string", "minLength": 1 },
        "signal_type": { "enum": ["rapid_growth", "new_policy", "new_dataset", "new_model", "cross_stream_bridge", "citation_burst"] },
        "statement": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "graph_node_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
