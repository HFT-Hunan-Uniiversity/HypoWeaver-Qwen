# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend/src

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-lock.txt backend/requirements-knowledge.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-knowledge.txt

COPY backend/src/ ./backend/src/
COPY backend/config/ ./backend/config/

RUN useradd --create-home --uid 10002 knowledge \
    && mkdir -p /app/knowledge \
    && chown -R knowledge:knowledge /app

USER knowledge
EXPOSE 8002
CMD ["python", "-m", "uvicorn", "hypoweaver.knowledge_api:app", "--host", "0.0.0.0", "--port", "8002"]
